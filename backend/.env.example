OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# LangSmith observability (optional - leave blank to disable tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=uptime-copilot

SLACK_WEBHOOK_URL=

CMMS_MCP_URL=
CMMS_MCP_TOKEN=

# Demo-tuned (real 15s = simulated 12h) so events show up in under a minute during a demo.
# Code defaults if these are unset/removed are 60/1 (real 1min = simulated 1h) - see README.
SIM_TICK_SECONDS=15
SIM_HOURS_PER_TICK=12
SIM_SEED=42
